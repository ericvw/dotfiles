#!/usr/bin/env bash
# vim: foldmethod=marker

set -euo pipefail

# Configuration {{{
# Every GnuPG socket Ubuntu socket-activates. All six are managed so the
# distro installation owns none of them; gpg-agent-ssh.socket is here for that
# reason, not because this helper configures SSH authentication.
SOCKETS=(
    gpg-agent.socket
    gpg-agent-ssh.socket
    gpg-agent-extra.socket
    gpg-agent-browser.socket
    keyboxd.socket
    dirmngr.socket
)

# The ssh, extra, and browser sockets activate on demand, so starting the
# primaries is enough to hand socket activation back to the distro.
RESTORE_SOCKETS=(
    gpg-agent.socket
    keyboxd.socket
    dirmngr.socket
)

PROC_VERSION="${GPG_BREW_PROC_VERSION:-/proc/version}"
GNUPG_HOME="${GNUPGHOME:-$HOME/.gnupg}"

BREW_PREFIX=
BREW_GPG=
BREW_GPGCONF=
# }}}

# Helpers {{{
log() { printf "\033[1;34m==>\033[0m %s\n" "$*" >&2; }
warn() { printf "\033[1;33m!!\033[0m %s\n" "$*" >&2; }
err() { printf "\033[1;31mxx\033[0m %s\n" "$*" >&2; }

have() { command -v "$1" > /dev/null 2>&1; }
# }}}

# Preconditions {{{
is_wsl() {
    # Works for WSL1/WSL2.
    grep -qiE "(microsoft|wsl)" "$PROC_VERSION" 2> /dev/null
}

# A liveness probe rather than is-system-running, which reports "degraded"
# under WSL often enough to be useless as a gate.
has_systemd_user() {
    have systemctl && systemctl --user show-environment > /dev/null 2>&1
}

# Sets BREW_PREFIX, BREW_GPG, and BREW_GPGCONF. Returns non-zero instead of
# exiting so restore and status can degrade when Homebrew is gone. No prefix
# is hard-coded: a /home/linuxbrew fallback would silently pick up an
# installation the caller's environment does not actually point at.
resolve_brew() {
    local prefix="${HOMEBREW_PREFIX:-}"
    if [[ -z "$prefix" ]] && have brew; then
        prefix=$(brew --prefix 2> /dev/null) || prefix=
    fi
    [[ -n "$prefix" ]] || return 1

    BREW_PREFIX="$prefix"
    BREW_GPG="$prefix/bin/gpg"
    BREW_GPGCONF="$prefix/bin/gpgconf"
}

has_brew_gnupg() {
    resolve_brew && [[ -x "$BREW_GPG" && -x "$BREW_GPGCONF" ]]
}

require_wsl() {
    if ! is_wsl; then
        err "gpg-brew only applies to WSL; no WSL marker in $PROC_VERSION."
        exit 1
    fi
}

require_systemd_user() {
    if ! have systemctl; then
        err "systemctl not found; gpg-brew needs a systemd user session."
        exit 1
    fi
    if ! systemctl --user show-environment > /dev/null 2>&1; then
        err "No usable systemd user session."
        warn "Set '[boot] systemd=true' in /etc/wsl.conf, then run"
        warn "'wsl.exe --shutdown' from Windows and reopen this distro."
        exit 1
    fi
}

require_brew_gnupg() {
    if ! resolve_brew; then
        err "Cannot resolve the Homebrew prefix."
        warn "Put brew on PATH or export HOMEBREW_PREFIX (see 'brew shellenv')."
        exit 1
    fi

    local cmd
    for cmd in "$BREW_GPG" "$BREW_GPGCONF"; do
        if [[ ! -x "$cmd" ]]; then
            err "Homebrew GnuPG is missing: $cmd is not executable."
            warn "Install it with 'brew install gnupg'. gpg-brew never installs packages."
            exit 1
        fi
    done
}
# }}}

# Status helpers {{{
socket_state() {
    systemctl --user is-enabled "$1" 2> /dev/null || true
}

# Emit "<pid> <owner> <argv>" per running GnuPG daemon. Ownership comes from
# the executable path, never from a version number.
daemon_report() {
    ps -eo pid=,args= 2> /dev/null | awk -v prefix="${BREW_PREFIX:-}" '
        {
            n = split($2, path, "/")
            name = path[n]
            if (name != "gpg-agent" && name != "keyboxd" && name != "dirmngr")
                next

            owner = "unknown"
            if (prefix != "" && index($2, prefix "/") == 1)
                owner = "homebrew"
            else if (index($2, "/usr/") == 1)
                owner = "distro"

            args = $0
            sub(/^[ \t]*[0-9]+[ \t]+/, "", args)
            printf "%s %s %s\n", $1, owner, args
        }
    ' || true
}

gpg_version() {
    local out
    out=$("$BREW_GPG" --version 2> /dev/null) || out=
    printf '%s' "${out%%$'\n'*}"
}

use_keyboxd_enabled() {
    [[ -f "$GNUPG_HOME/common.conf" ]] &&
        grep -qE '^[[:space:]]*use-keyboxd([[:space:]]|$)' "$GNUPG_HOME/common.conf"
}
# }}}

# Commands {{{
cmd_setup() {
    require_wsl
    require_systemd_user
    require_brew_gnupg

    log "Masking Ubuntu's GnuPG systemd user sockets..."
    systemctl --user mask --now "${SOCKETS[@]}"

    log "Stopping running GnuPG daemons via $BREW_GPGCONF..."
    "$BREW_GPGCONF" --kill all

    log "Homebrew GnuPG at $BREW_PREFIX now owns the GnuPG daemons."
    log "Verify with 'gpg-brew status'."
}

cmd_restore() {
    require_wsl
    require_systemd_user

    log "Unmasking Ubuntu's GnuPG systemd user sockets..."
    systemctl --user unmask "${SOCKETS[@]}"

    # Removing Homebrew GnuPG is a likely reason to run restore, so the kill
    # is best effort while the unmask and start are not.
    if has_brew_gnupg; then
        log "Stopping running GnuPG daemons via $BREW_GPGCONF..."
        "$BREW_GPGCONF" --kill all
    else
        warn "Homebrew GnuPG not found; leaving running daemons alone."
        warn "Stop any that remain with 'gpgconf --kill all'."
    fi

    log "Starting Ubuntu's GnuPG socket activation..."
    systemctl --user start "${RESTORE_SOCKETS[@]}"

    log "Ubuntu GnuPG socket activation restored."
}

cmd_status() {
    local wsl=false systemd_user=false systemd_reliable=false
    is_wsl && wsl=true
    has_systemd_user && systemd_user=true
    if $wsl && $systemd_user; then
        systemd_reliable=true
    fi

    local brew_resolved=false brew_gnupg=false
    if resolve_brew; then
        brew_resolved=true
    fi
    if $brew_resolved && [[ -x "$BREW_GPG" && -x "$BREW_GPGCONF" ]]; then
        brew_gnupg=true
    fi

    printf 'Platform\n'
    if $wsl; then
        printf '  wsl:           yes\n'
    else
        printf '  wsl:           no (no WSL marker in %s)\n' "$PROC_VERSION"
    fi
    if $systemd_user; then
        printf '  systemd user:  available\n'
    else
        printf '  systemd user:  unavailable\n'
    fi
    printf '\n'

    printf 'Homebrew\n'
    if ! $brew_resolved; then
        printf '  prefix:        unresolved (brew not on PATH, HOMEBREW_PREFIX unset)\n'
    else
        printf '  prefix:        %s\n' "$BREW_PREFIX"
        if [[ -x "$BREW_GPG" ]]; then
            printf '  gpg:           %s (%s)\n' "$BREW_GPG" "$(gpg_version)"
        else
            printf '  gpg:           missing at %s\n' "$BREW_GPG"
        fi
        if [[ -x "$BREW_GPGCONF" ]]; then
            printf '  gpgconf:       %s\n' "$BREW_GPGCONF"
        else
            printf '  gpgconf:       missing at %s\n' "$BREW_GPGCONF"
        fi
    fi
    printf '\n'

    printf 'GnuPG home\n'
    printf '  homedir:       %s\n' "$GNUPG_HOME"
    if use_keyboxd_enabled; then
        printf '  use-keyboxd:   enabled in common.conf (keyboxd participates)\n'
    else
        printf '  use-keyboxd:   not enabled\n'
    fi
    printf '\n'

    local unit state unmasked=0 unknown=0
    printf 'Managed systemd user sockets\n'
    if $systemd_reliable; then
        for unit in "${SOCKETS[@]}"; do
            state=$(socket_state "$unit")
            printf '  %-26s %s\n' "$unit" "${state:-unknown}"
            case "$state" in
                masked | masked-runtime | not-found) ;;
                '') unknown=$((unknown + 1)) ;;
                *) unmasked=$((unmasked + 1)) ;;
            esac
        done
    else
        for unit in "${SOCKETS[@]}"; do
            printf '  %-26s %s\n' "$unit" "unknown (ownership check unavailable)"
        done
    fi
    printf '\n'

    local daemons pid owner args distro=0 daemon_unknown=0
    daemons=$(daemon_report)
    printf 'Running GnuPG daemons\n'
    if [[ -z "$daemons" ]]; then
        printf '  none\n'
    else
        while read -r pid owner args; do
            printf '  %-8s %-9s %s\n' "$pid" "$owner" "$args"
            case "$owner" in
                distro) distro=$((distro + 1)) ;;
                unknown) daemon_unknown=$((daemon_unknown + 1)) ;;
            esac
        done <<< "$daemons"
    fi
    printf '\n'

    printf 'Verdict\n'
    if ! $systemd_reliable; then
        if ! $wsl; then
            printf '  indeterminate: not running under WSL, so socket ownership cannot be checked.\n'
        else
            printf '  indeterminate: no usable systemd user session, so socket ownership cannot be checked.\n'
        fi
    elif ((distro > 0 && unmasked > 0)); then
        printf '  distro-owned: Ubuntu socket activation is live and its daemons are running.\n'
        printf '  Run "gpg-brew setup" to hand ownership to Homebrew GnuPG.\n'
    elif ((unmasked > 0)); then
        printf '  distro-owned: Ubuntu socket activation can still start its daemons.\n'
        printf '  Run "gpg-brew setup" to hand ownership to Homebrew GnuPG.\n'
    elif ((unknown > 0)); then
        printf '  indeterminate: one or more socket states could not be determined.\n'
    elif ((distro > 0)); then
        printf '  inconsistent: sockets are masked but distro daemons are still running.\n'
        printf '  Run "gpgconf --kill all" to clear them.\n'
    elif ! $brew_gnupg; then
        printf '  unowned: sockets are masked but Homebrew GnuPG is unavailable.\n'
        printf '  Run "brew install gnupg" or "gpg-brew restore".\n'
    elif ((daemon_unknown > 0)); then
        printf '  indeterminate: one or more running GnuPG daemons have unknown ownership.\n'
    else
        printf '  homebrew-owned: every managed socket is masked and no distro daemon is running.\n'
    fi
}
# }}}

# Usage {{{
usage() {
    cat << EOF
Usage: gpg-brew <command>

Commands:
  status     Report GnuPG daemon ownership and managed socket state
  setup      Mask Ubuntu's GnuPG systemd user sockets so Homebrew GnuPG
             spawns and owns its own matching daemons
  restore    Unmask those sockets and hand activation back to Ubuntu

Options:
  -h, --help   Show help

WSL-specific. Runs entirely as your user: no sudo, no system-wide files, no
systemd unit overrides. Never installs packages. SSH authentication is left
to keychain and is untouched.

Managed systemd user sockets:
EOF
    printf '  %s\n' "${SOCKETS[@]}"
}
# }}}

# Main {{{
main() {
    if [[ $# -gt 1 ]]; then
        err "Unknown argument: $2"
        usage
        exit 1
    fi

    case "${1:-}" in
        status) cmd_status ;;
        setup) cmd_setup ;;
        restore) cmd_restore ;;
        -h | --help) usage ;;
        "")
            err "A command is required."
            usage
            exit 1
            ;;
        *)
            err "Unknown command: $1"
            usage
            exit 1
            ;;
    esac
}

main "$@"
# }}}
